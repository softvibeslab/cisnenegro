# Plantilla para /etc/cisne/app.env; completar claves privadas antes del despliegue.
CMS_ORIGIN=https://cisnenegro.mx
CMS_ALLOWED_ORIGINS=https://cisne.softvibes.art,https://www.cisnenegro.mx,https://cisnenegro.mx
# Solo este host HTTPS indexará las páginas públicas; temporal y paneles quedan bloqueados.
PUBLIC_INDEX_HOST=cisnenegro.mx
APP_DATA_DIR=/var/data
PORT=8080
# En servidor con proxy local: APP_BIND=127.0.0.1. Dentro de Docker: 0.0.0.0.
APP_BIND=0.0.0.0
CLUB_SECRET=
CLUB_ADMIN_TOKEN=
# Solo si se instala una base vacía; omitir si se restauran las cuentas reales.
CMS_BOOTSTRAP_USER=
CMS_BOOTSTRAP_PASSWORD=

# Agente Cisne: hermes para usar un perfil autorizado de Cisne; openai para API directa.
# Hermes requiere instalación/autenticación local o conexión al bridge privado.
CISNE_AGENT_PROVIDER=hermes
# Solo cisne-negro o cisnenegro. Debe coincidir en CMS y bridge/worker.
CISNE_HERMES_PROFILE_NAME=cisne-negro
# Opcionales; por defecto ~/.hermes/hermes-agent y ~/.hermes/profiles/<nombre>.
CISNE_HERMES_ROOT=
CISNE_HERMES_PROFILE_DIR=
# Opcional: socket Unix del bridge privado; no admite URLs ni selecciona perfiles del navegador.
CISNE_HERMES_SOCKET=
# Imágenes: clave propia del servidor, nunca en HTML, Telegram ni Git.
# Vacía desactiva imágenes; el chat Hermes usa la autenticación de su perfil.
OPENAI_API_KEY=
CISNE_AGENT_MODEL=gpt-6-astra
CISNE_IMAGE_MODEL=gpt-image-2.5-sunburst
